@echo off
chcp 65001 >nul
setlocal
cd /d "%~dp0..\.."

echo.
echo   Обновление маркетплейса.
echo.

rem Проверяем файл внутри .git, а не саму папку: так надёжнее,
rem пустая или битая папка .git за рабочую копию не сойдёт
if not exist ".git\HEAD" (
  echo   ------------------------------------------------
  echo   Эта папка скачана архивом, а не через Git —
  echo   обновиться на месте не получится.
  echo.
  echo   Либо скачайте архив заново с GitHub и распакуйте,
  echo   либо перейдите на Git — тогда обновление станет
  echo   одним щелчком по этому файлу. Как перейти,
  echo   написано в docs\13-local-server.md
  echo   ------------------------------------------------
  echo.
  pause
  exit /b 1
)

rem --ff-only: если что-то разошлось, честно останавливаемся,
rem а не создаём запутанное состояние, которое придётся разбирать
call git pull --ff-only
if errorlevel 1 (
  echo.
  echo   ------------------------------------------------
  echo   Обновление не встало ровно. Обычно это значит,
  echo   что в папке что-то поменяли вручную.
  echo.
  echo   Ничего не сломано и не потеряно. Пришлите мне
  echo   текст выше — подскажу, что делать.
  echo   ------------------------------------------------
  echo.
  pause
  exit /b 1
)

call pnpm install
if errorlevel 1 (
  echo.
  echo   Не получилось обновить библиотеки. Пришлите текст выше.
  pause
  exit /b 1
)

call node scripts\local-setup.mjs
if errorlevel 1 (
  pause
  exit /b 1
)

echo.
echo   Обновлено. Запускайте start.bat
echo.
pause
