# Скопировать в .env и заполнить. Приложение падает на старте
# с понятной ошибкой, если чего-то не хватает — это специально.

# --- Приложение ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=marketplace-for-business
SESSION_SECRET=            # 32+ случайных байта: openssl rand -base64 48

# --- База ---
# ВАЖНО: сервер только в России — 152-ФЗ, персональные данные
DATABASE_URL=postgres://user:pass@localhost:5432/marketplace
DATABASE_URL_TEST=postgres://user:pass@localhost:5432/marketplace_test

# --- Воркер ---
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=50
WORKER_MAX_ATTEMPTS=10

# --- Почта ---
# Только российский SMTP. Зарубежный шлюз = персданные за границей
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Маркетплейс для бизнеса <noreply@example.ru>"
# В разработке письма пишутся в лог вместо отправки
MAIL_TRANSPORT=log          # log | smtp

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Хранилище файлов (S3-совместимое, в РФ) ---
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Эквайринг ---
# Схема расчётов не выбрана окончательно: прямая оплата подрядчику
# со счётом на комиссию, либо сплит-платёж. Уточнить у провайдера до месяца 4
ACQUIRING_PROVIDER=none     # none | yookassa | tinkoff
ACQUIRING_SHOP_ID=
ACQUIRING_SECRET_KEY=
ACQUIRING_WEBHOOK_SECRET=

# --- ИИ-сервис ---
# Появляется на пятом месяце. До этого подбор идёт по правилам
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=2000
AI_SERVICE_ENABLED=false

# --- Наблюдаемость ---
LOG_LEVEL=info
# Только self-hosted: Sentry SaaS и зарубежная аналитика запрещены (152-ФЗ)
ERROR_TRACKING_DSN=

# --- Бизнес-правила ---
COMMISSION_RATE_SERVICES=0.13
COMMISSION_RATE_GOODS=0.07
OFFER_COLLECTION_TIMEOUT_MINUTES=120
QUOTES_SHOWN_TO_CLIENT=3
