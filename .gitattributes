# Переводы строк не должны зависеть от того, кто скачал репозиторий
* text=auto eol=lf

# Кроме файлов для Windows: cmd.exe спотыкается на чужих переводах строк,
# и ошибка выглядит как «неверный синтаксис команды», а не как проблема формата
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Двоичные — не трогать
*.woff2 binary
*.png binary
*.pdf binary
